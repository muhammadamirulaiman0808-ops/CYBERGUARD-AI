# Copy this file to ".env" and fill in real values. Never commit ".env".

# development | production
APP_ENV=development

# Supabase: Project Settings > Database > Connection string (use the pooler URL).
# If the password contains special characters (! @ # ...), URL-encode them (@ -> %40, ! -> %21).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Login lifetime in minutes
ACCESS_TOKEN_MINUTES=60

# Where the frontend runs (comma-separated for several). Used for CORS.
FRONTEND_URL=http://localhost:5173

# Optional: also allow Vercel preview URLs, e.g. https://cyberguard-.*\.vercel\.app
FRONTEND_ORIGIN_REGEX=

# Development only: lets you scan localhost / private IPs. Ignored when APP_ENV=production.
ALLOW_PRIVATE_TARGETS=false
